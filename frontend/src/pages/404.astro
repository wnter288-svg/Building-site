---
/**
 * Страница 404. Кадр во весь экран, текст поверх него.
 *
 * Своего скрипта на странице нет, и это осознанно: ошибочный адрес —
 * худший момент, чтобы зависеть от бандла, который сам может не
 * приехать. Появление строк заголовка делает CSS-анимация из global.css
 * (.hero-lines + .lm), наблюдатели и параллакс тут не нужны. Astro всё
 * же кладёт свой префетч (~2.2 КБ) — он общий для всех страниц.
 */
import Layout from '../layouts/Layout.astro';
import Logo from '../components/ui/Logo.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { notFound, isStub } from '../content/site';

export const prerender = true;

const hasPhoto = !isStub(notFound.photo);
---
<Layout title={notFound.meta.title} description={notFound.meta.description} noindex>
  <div class="nf">
    {hasPhoto && (
      <img
        class="nf__bg"
        src={notFound.photo}
        alt={notFound.mediaAlt}
        width="1829"
        height="860"
        fetchpriority="high"
        decoding="async"
      />
    )}

    <header class="nf__head">
      <div class="nf__bar">
        <a href="/" class="nf__logo" aria-label="DIMORA, на головну">
          <Logo width={150} />
        </a>
        <nav class="nf__nav" aria-label="Основна навігація">
          {notFound.nav.map((i) => <a class="ln" href={i.href}>{i.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main" class="nf__body">
      <div class="nf__text hero-lines">
        <Eyebrow>{notFound.eyebrow}</Eyebrow>

        <p class="nf__code">{notFound.code}</p>

        <h1 class="nf__title">
          {notFound.titleLines.map((line, i) => (
            <span class="lm"><span style={i ? `animation-delay:${i * 120}ms` : undefined}>{line}</span></span>
          ))}
        </h1>

        <p class="nf__lead">{notFound.lead}</p>

        <div class="nf__acts">
          <a class="nf__back ln" href={notFound.primary.href}>
            <span class="nf__arw" aria-hidden="true">&#8592;</span>
            <span>{notFound.primary.label}</span>
          </a>
          <a class="nf__alt ln" href={notFound.secondary.href}>{notFound.secondary.label}</a>
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    /* Фон под кадром на случай, если снимок не приедет: страница
       останется читаемой, а не станет белым листом. */
    background: var(--c-svet);
  }

  /* ——— Кадр ———
     Снимок шире любого экрана (2.13:1), поэтому cover режет его по
     бокам. Держим привязку слева: пустое небо остаётся под текстом,
     а дом уходит вправо — ровно та композиция, что в оригинале. */
  .nf__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    z-index: -1;
  }
  /* На широком экране обрезка мягче, и кадр можно подвинуть: в поле
     зрения входит крона, а текст всё ещё лежит на небе.
     Замерено по этому снимку: самая тёмная точка в зоне текста —
     0.583 яркости, это Хвоя 9.6:1 и Мох 4.57:1. Ниже 4.5 не опускаемся,
     поэтому мелкий текст на странице набран не Мхом (см. --text-muted). */
  @media (min-width: 821px) {
    .nf__bg { object-position: 25% center; }
  }

  /* ——— Общее поле слева ———
     Шапка и текст считают одно и то же смещение, поэтому стоят на одной
     вертикали. Контейнер сайта 1280 сдвинут к краю: на этой странице
     текст лежит на пустом небе, и прижимать его к середине незачем.
     Поправка --sbw не нужна: ширма ровно в экран, полосы прокрутки нет,
     значит 100vw равен ширине контента. */
  .nf { --nf-x: max(clamp(20px, 4vw, 24px), calc((100vw - 1280px) / 2 - clamp(0px, 2.2vw, 40px))); }

  /* Мелкий текст поверх снимка набираем --text-body вместо Мха: Мох даёт
     4.57:1 при норме 4.5 — запас в сотые, любая правка кадра его съест.
     --text-body в той же точке даёт 7.07:1. Крупное «404» ниже забирает
     настоящий Мох обратно: для крупного текста норма 3.0. */
  .nf__head, .nf__body { --text-muted: var(--text-body); }

  /* ——— Шапка ———
     Своя, а не Header.astro: тот светит Льном по тёмному видео первого
     экрана и на светлом небе стал бы невидимым. Здесь нужны только
     логотип и две ссылки — ни телефона, ни CTA, ни бургера. */
  .nf__head { position: relative; padding: 26px var(--nf-x) 0; }
  .nf__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  /* Логотип берёт цвет через currentColor — один файл и на тёмном, и на
     светлом фоне, перекрашивать нечего. */
  .nf__logo { display: block; flex: 0 0 auto; color: var(--text-strong); }
  .nf__logo :global(svg) { width: 100%; height: auto; display: block; }
  .nf__nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.6vw, 38px);
    font: var(--t-small);
    color: var(--text-muted);
  }
  .nf__nav a { color: inherit; }
  .nf__nav a:hover { color: var(--text-strong); }

  /* ——— Текст ——— */
  .nf__body {
    position: relative;
    display: flex;
    align-items: center;
    padding: clamp(48px, 7vw, 88px) var(--nf-x) clamp(56px, 8vw, 104px);
  }

  .nf__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(var(--s-16), 2vw, var(--s-24));
    /* Уже обычной меры: строка не должна уезжать с неба на дом. */
    max-width: min(var(--measure), 46vw);
  }
  @media (max-width: 820px) {
    .nf__text { max-width: var(--measure); }
  }

  /* Код ошибки. Крупный, но не кричащий: цифры набраны тем же
     Cormorant, что и заголовки, светлым начертанием и настоящим Мхом —
     иначе они спорят с h1 за первое место в кадре. Кегль крупный,
     поэтому норма контраста 3.0, а не 4.5. */
  .nf__code {
    margin: 0;
    font: 300 clamp(72px, 12vw, 148px)/0.9 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--c-moh);
  }

  .nf__title {
    margin: 0;
    font: 300 clamp(28px, 3.4vw, 50px)/1.15 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
  }

  .nf__lead {
    margin: 0;
    font: var(--t-lead);
    color: var(--text-body);
    text-wrap: pretty;
  }

  /* ——— Действия ———
     Вместо залитой кнопки — ссылка со стрелкой, как в присланном
     референсе: на снимке во весь экран тёмный прямоугольник читается
     как заплатка. */
  .nf__acts {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(var(--s-20), 2.5vw, var(--s-40));
    margin-top: clamp(var(--s-8), 1vw, var(--s-16));
  }
  .nf__back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-12);
    font: var(--t-button);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    color: var(--text-strong);
  }
  /* Стрелка уезжает влево — туда же, куда ведёт ссылка. Общий класс
     .arw из global.css двигает вправо, поэтому здесь своя. */
  .nf__arw {
    display: inline-block;
    font-size: 1.2em;
    line-height: 1;
    transition: transform .28s var(--ease-calm);
  }
  .nf__back:hover .nf__arw { transform: translateX(-7px); }

  .nf__alt { font: var(--t-small); color: var(--text-muted); }
  .nf__alt:hover { color: var(--text-strong); }

  @media (prefers-reduced-motion: reduce) {
    .nf__arw { transition: none; }
  }
</style>
