---
/**
 * Логотип DIMORA. Буквы переведены в кривые — живого текста нет,
 * поэтому он не зависит от загрузки шрифта Cinzel (тот вообще не
 * подключается) и выглядит одинаково даже до загрузки стилей.
 *
 * Геометрия из дизайн-системы: крыша над DIM и линия земли под ней
 * складываются в силуэт дома, где DIM читается как "дiм".
 *
 * Цвет наследуется через currentColor — один файл работает и на
 * тёмном, и на светлом фоне.
 */
interface Props {
  width?: number;
  class?: string;
  title?: string;
}
const { width = 170, class: className, title = 'DIMORA' } = Astro.props;
const RATIO = 640 / 230;
