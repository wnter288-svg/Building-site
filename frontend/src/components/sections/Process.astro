---
import Eyebrow from '../ui/Eyebrow.astro';
import { process } from '../../content/site';
const first = process.steps[0];
---
<section id="process" class="process">
  <div class="process__grid">
    <div class="pr-sticky">
      <Eyebrow>{process.eyebrow}</Eyebrow>
      <h2 class="process__title lines-r" data-reveal>
        {process.titleLines.map((line, i) => (
          <span class="lm"><span style={i ? `animation-delay:${i * 120}ms` : undefined}>{line}</span></span>
        ))}
      </h2>
      <!-- Крупный счётчик догоняет тот шаг, который сейчас в центре экрана -->
      <div class="process__marker" aria-hidden="true">
        <span class="pr-num" data-pr-num>{first.n}</span>
        <span class="pr-lab" data-pr-lab>{first.title}</span>
      </div>
    </div>

    <ol class="process__steps">
      {process.steps.map((s, i) => (
        <li
          class="pr-step"
          class:list={['pr-step', i === process.steps.length - 1 && 'pr-step--last']}
          data-n={s.n}
          data-t={s.title}
          data-reveal
        >
          <span class="pr-step__n">{s.n}</span>
          <div class="pr-step__body">
            <h3 class="pr-step__title">{s.title}</h3>
            <p class="pr-step__text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { background: var(--c-svet); padding: clamp(72px, 9vw, 120px) clamp(20px, 4vw, 24px); }
  .process__grid {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(36px, 5vw, 80px); align-items: start;
  }
  .pr-sticky {
    position: sticky; top: clamp(96px, 14vh, 150px);
    display: flex; flex-direction: column; gap: clamp(20px, 2.5vw, 32px);
  }
  .process__title {
    margin: 0;
    font: 300 clamp(30px, 3.6vw, 54px)/1.14 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
  }
  .process__marker {
    border-top: 1px solid var(--border-hairline);
    padding-top: 24px; margin-top: 8px;
    display: flex; align-items: baseline; gap: 20px;
  }
  .pr-num { font: 300 clamp(64px, 9vw, 150px)/.9 var(--font-display); color: var(--text-accent); }
  .pr-lab { font: var(--t-small); color: var(--text-muted); }

  .process__steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .pr-step {
    border-top: 1px solid var(--border-hairline);
    padding: clamp(26px, 3vw, 40px) 0;
    display: grid; grid-template-columns: auto 1fr;
    gap: clamp(20px, 3vw, 40px); align-items: start;
  }
  .pr-step--last { border-bottom: 1px solid var(--border-hairline); }
  .pr-step__n { font: 400 clamp(20px, 1.8vw, 24px)/1.2 var(--font-display); color: var(--text-faint); }
  .pr-step__body { display: flex; flex-direction: column; gap: 12px; }
  .pr-step__title { margin: 0; font: 400 clamp(20px, 2vw, 26px)/1.3 var(--font-display); color: var(--text-strong); }
  .pr-step__text { font: var(--t-body); color: var(--text-muted); max-width: 52ch; text-wrap: pretty; }
</style>
