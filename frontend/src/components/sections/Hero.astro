---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { hero } from '../../content/site';
---
<section id="top" class="hero">
  <!-- Фон — одна фотография. Раньше здесь крутился таймлапс стройки: он
       весил 4.65 МБ, на мобильном не грузился вовсе и оставлял пустой
       экран, поэтому заменён на статичный кадр. -->
  <div class="hero__media" data-hero-media>
    <div class="hero__poster" data-hero-poster></div>
  </div>
  <div class="hero__scrim hero__scrim--x"></div>
  <div class="hero__scrim hero__scrim--y"></div>
  <div class="hero__veil" data-hero-veil></div>

  <div class="hero__body">
    <div class="hero__inner">
      <div class="hero__col">
        <Eyebrow>{hero.eyebrow}</Eyebrow>
        <h1 class="hero__title hero-lines">
          {hero.titleLines.map((line, i) => (
            <span class="lm"><span style={i ? `animation-delay:${i * 120}ms` : undefined}>{line}</span></span>
          ))}
        </h1>
        <p class="hero__lead">{hero.lead}</p>
        <div class="hero__actions">
          <span class="magnet" data-magnet>
            <Button variant="primary" href={hero.primary.href}>{hero.primary.label}</Button>
          </span>
          <Button variant="outline" href={hero.secondary.href}>{hero.secondary.label}</Button>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__foot">
    <div class="hero__foot-inner">
      <div class="facts">
        {hero.facts.map((f) => (
          <div class="fact">
            <span class="fact__v" data-count>{f.value}</span>
            <span class="fact__l">{f.label}</span>
          </div>
        ))}
      </div>
      <div class="scroll">
        <span class="scroll__label">{hero.scrollLabel}</span>
        <span class="scroll__track"><span class="scroll-run"></span></span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Мелкие подписи первого экрана лежат на фотографии, а не на ровном
     фоне, поэтому приглушённый Мох здесь не добирает норму контраста.
     Внутри секции --text-muted подменяется на основной цвет текста —
     Eyebrow и подписи фактов красятся от него и темнеют вместе с ним. */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; --text-muted: var(--text-body); }
  .hero__media { position: absolute; inset: -2% 0 0 0; z-index: 0; will-change: transform; }
  .hero__poster {
    position: absolute; inset: 0;
    background: var(--n-050);
    background-size: cover; background-position: center;
  }

  /* Экран светлый, поэтому засветка, а не затемнение: слева фотография
     уводится почти в цвет фона, чтобы тёмный заголовок читался поверх
     неба и бликов, справа кадр остаётся чистым. */
  .hero__scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .hero__scrim--x { background: linear-gradient(90deg, rgba(246,244,239,.72) 0%, rgba(246,244,239,.62) 44%, rgba(246,244,239,.16) 72%, rgba(246,244,239,.02) 100%); }
  .hero__scrim--y { background: linear-gradient(180deg, rgba(246,244,239,.38) 0%, rgba(246,244,239,0) 30%, rgba(246,244,239,0) 54%, rgba(246,244,239,.60) 100%); }
  .hero__veil { position: absolute; inset: 0; z-index: 1; background: var(--c-svet); opacity: 0; pointer-events: none; }

  .hero__body {
    position: relative; z-index: 2; flex: 1;
    display: flex; align-items: center;
    padding: clamp(120px, 16vh, 180px) clamp(20px, 4vw, 24px) clamp(32px, 5vh, 56px);
  }
  .hero__inner { max-width: 1280px; margin: 0 auto; width: 100%; }
  .hero__col { width: 100%; max-width: 680px; display: flex; flex-direction: column; gap: clamp(24px, 3vw, 36px); }
  .hero__title {
    margin: 0;
    font: 300 clamp(44px, 9.2vw, 124px)/1.04 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
  }
  .hero__lead { font: var(--t-lead); color: var(--text-body); max-width: 44ch; text-wrap: pretty; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 8px; }

  .hero__foot { position: relative; z-index: 2; padding: 0 clamp(20px, 4vw, 24px) clamp(32px, 5vh, 52px); }
  .hero__foot-inner {
    max-width: 1280px; margin: 0 auto;
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(24px, 4vw, 56px); flex-wrap: wrap;
  }
  .facts { display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 72px); }
  .fact {
    display: flex; flex-direction: column; gap: 8px;
    border-top: 1px solid var(--border-soft);
    padding-top: 16px; min-width: 150px;
  }
  .fact__v { font: 400 clamp(32px, 3.4vw, 52px)/1 var(--font-display); color: var(--text-strong); }
  .fact__l { font: var(--t-caption); color: var(--text-muted); }

  .scroll { display: flex; align-items: center; gap: 16px; }
  /* Лежит в правой части кадра, где засветки почти нет, поэтому цвет
     основной, а не приглушённый — иначе не добирает норму контраста. */
  .scroll__label { font: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-strong); }
  .scroll__track { position: relative; display: block; width: 1px; height: 64px; background: var(--border-soft); overflow: hidden; }
  .scroll-run { position: absolute; inset: 0; background: var(--text-accent); animation: dmRun 2.8s var(--ease-calm) infinite; }
</style>
