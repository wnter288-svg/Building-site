---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { hero } from '../../content/site';
---
<section id="top" class="dm-dark hero">
  <!-- Медиа. Постер стоит фоном сразу, видео подключается скриптом
       и только на десктопе — на мобильном оно не грузится вообще. -->
  <div class="hero__media" data-hero-media>
    <div class="hero__poster" data-hero-poster>
      <span class="hero-cap">{hero.mediaCaption}</span>
    </div>
    <video class="hero__vid" data-hero-video muted loop playsinline preload="none"></video>
  </div>
  <div class="hero__scrim hero__scrim--x"></div>
  <div class="hero__scrim hero__scrim--y"></div>
  <div class="hero__veil" data-hero-veil></div>

  <div class="hero__body">
    <div class="hero__inner">
      <div class="hero__col">
        <Eyebrow>{hero.eyebrow}</Eyebrow>
        <h1 class="hero__title hero-lines">
          {hero.titleLines.map((line, i) => (
            <span class="lm"><span style={i ? `animation-delay:${i * 120}ms` : undefined}>{line}</span></span>
          ))}
        </h1>
        <p class="hero__lead">{hero.lead}</p>
        <div class="hero__actions">
          <span class="magnet" data-magnet>
            <Button variant="primary" href={hero.primary.href}>{hero.primary.label}</Button>
          </span>
          <Button variant="outline" href={hero.secondary.href}>{hero.secondary.label}</Button>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__foot">
    <div class="hero__foot-inner">
      <div class="facts">
        {hero.facts.map((f) => (
          <div class="fact">
            <span class="fact__v" data-count>{f.value}</span>
            <span class="fact__l">{f.label}</span>
          </div>
        ))}
      </div>
      <div class="scroll">
        <span class="scroll__label">{hero.scrollLabel}</span>
        <span class="scroll__track"><span class="scroll-run"></span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; }
  .hero__media { position: absolute; inset: -2% 0 0 0; z-index: 0; will-change: transform; }
  .hero__poster {
    position: absolute; inset: 0;
    background: var(--c-hvoia);
    background-size: cover; background-position: center;
    display: flex; align-items: flex-start; justify-content: flex-end;
    padding: clamp(96px, 13vh, 150px) clamp(20px, 6vw, 90px) 0;
  }
  .hero-cap {
    max-width: 240px; text-align: right;
    font: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase;
    color: rgba(228, 223, 214, .34);
  }
  .hero__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .hero__scrim--x { background: linear-gradient(90deg, rgba(27,36,31,.92) 0%, rgba(27,36,31,.78) 34%, rgba(27,36,31,.42) 68%, rgba(27,36,31,.24) 100%); }
  .hero__scrim--y { background: linear-gradient(180deg, rgba(27,36,31,.6) 0%, rgba(27,36,31,0) 32%, rgba(27,36,31,0) 58%, rgba(27,36,31,.72) 100%); }
  .hero__veil { position: absolute; inset: 0; z-index: 1; background: var(--c-hvoia); opacity: 0; pointer-events: none; }

  .hero__body {
    position: relative; z-index: 2; flex: 1;
    display: flex; align-items: center;
    padding: clamp(120px, 16vh, 180px) clamp(20px, 4vw, 24px) clamp(32px, 5vh, 56px);
  }
  .hero__inner { max-width: 1280px; margin: 0 auto; width: 100%; }
  .hero__col { width: 100%; max-width: 680px; display: flex; flex-direction: column; gap: clamp(24px, 3vw, 36px); }
  .hero__title {
    margin: 0;
    font: 300 clamp(44px, 9.2vw, 124px)/1.04 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--c-len);
  }
  .hero__lead { font: var(--t-lead); color: rgba(228, 223, 214, .78); max-width: 44ch; text-wrap: pretty; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 8px; }

  .hero__foot { position: relative; z-index: 2; padding: 0 clamp(20px, 4vw, 24px) clamp(32px, 5vh, 52px); }
  .hero__foot-inner {
    max-width: 1280px; margin: 0 auto;
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(24px, 4vw, 56px); flex-wrap: wrap;
  }
  .facts { display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 72px); }
  .fact {
    display: flex; flex-direction: column; gap: 8px;
    border-top: 1px solid rgba(228, 223, 214, .22);
    padding-top: 16px; min-width: 150px;
  }
  .fact__v { font: 400 clamp(32px, 3.4vw, 52px)/1 var(--font-display); color: var(--c-len); }
  .fact__l { font: var(--t-caption); color: rgba(228, 223, 214, .6); }

  .scroll { display: flex; align-items: center; gap: 16px; }
  .scroll__label { font: var(--t-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: rgba(228,223,214,.5); }
  .scroll__track { position: relative; display: block; width: 1px; height: 64px; background: rgba(228,223,214,.2); overflow: hidden; }
  .scroll-run { position: absolute; inset: 0; background: var(--c-dub-light); animation: dmRun 2.8s var(--ease-calm) infinite; }
</style>
