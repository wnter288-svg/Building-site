---
import Eyebrow from '../ui/Eyebrow.astro';
import { services } from '../../content/site';
---
<section id="services" class="dm-dark services">
  <div class="services__inner">
    <div class="services__head" data-reveal>
      <Eyebrow>{services.eyebrow}</Eyebrow>
      <h2 class="services__title">{services.title}</h2>
    </div>
    <div class="services__grid">
      {services.items.map((s, i) => (
        <div class="svc" data-reveal data-delay={i * 90}>
          <span class="svc__n">{s.n}</span>
          <h3 class="svc__title">{s.title}</h3>
          <p class="svc__text">{s.text}</p>
          <ul class="svc__list">
            {s.list.map((li) => <li>{li}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding: clamp(72px, 9vw, 120px) clamp(20px, 4vw, 24px); }
  .services__inner { max-width: 1280px; margin: 0 auto; }
  .services__head {
    display: flex; flex-direction: column; gap: clamp(18px, 2vw, 24px);
    margin-bottom: clamp(48px, 6vw, 80px); max-width: 640px;
  }
  .services__title {
    margin: 0;
    font: 300 clamp(30px, 3.6vw, 54px)/1.15 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
  }
  .services__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }
  .svc {
    border-top: 1px solid var(--border-hairline);
    padding: clamp(24px, 2.6vw, 32px) 0 0;
    display: flex; flex-direction: column; gap: 20px;
  }
  .svc__n { font: 400 clamp(28px, 2.4vw, 36px)/1 var(--font-display); color: var(--text-accent); }
  .svc__title { margin: 0; font: 400 clamp(21px, 2vw, 28px)/1.3 var(--font-display); color: var(--text-strong); }
  .svc__text { font: var(--t-body); color: var(--text-muted); max-width: 38ch; text-wrap: pretty; }
  .svc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .svc__list li {
    font: var(--t-small); color: var(--text-faint);
    border-top: 1px solid var(--border-hairline); padding-top: 10px;
  }
</style>
