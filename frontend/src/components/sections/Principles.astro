---
import Eyebrow from '../ui/Eyebrow.astro';
import { principles } from '../../content/site';
---
<section id="principles" class="principles">
  <div class="principles__inner">
    <div class="principles__head" data-reveal>
      <Eyebrow>{principles.eyebrow}</Eyebrow>
      <h2 class="principles__title">{principles.title}</h2>
    </div>
    <div class="principles__grid">
      {principles.items.map((p, i) => (
        <div class="pr" data-reveal data-delay={i * 90}>
          <h3 class="pr__title">{p.title}</h3>
          <p class="pr__text">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .principles { background: var(--c-len); padding: clamp(72px, 9vw, 120px) clamp(20px, 4vw, 24px); }
  .principles__inner { max-width: 1280px; margin: 0 auto; }
  .principles__head {
    display: flex; flex-direction: column; gap: clamp(18px, 2vw, 24px);
    margin-bottom: clamp(48px, 6vw, 80px); max-width: 600px;
  }
  .principles__title {
    margin: 0;
    font: 300 clamp(30px, 3.6vw, 54px)/1.15 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
  }
  .principles__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(28px, 4vw, 64px);
  }
  .pr {
    border-top: 1px solid var(--border-soft);
    padding-top: 24px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .pr__title { margin: 0; font: 400 clamp(21px, 2vw, 28px)/1.3 var(--font-display); color: var(--text-strong); }
  .pr__text { font: var(--t-body); color: var(--text-muted); max-width: 46ch; text-wrap: pretty; }
</style>
