---
import Eyebrow from '../ui/Eyebrow.astro';
import { faq } from '../../content/site';
---
<section id="faq" class="faq-sec">
  <div class="faq-sec__grid">
    <div class="faq-sec__head" data-reveal>
      <Eyebrow>{faq.eyebrow}</Eyebrow>
      <h2 class="faq-sec__title">{faq.title}</h2>
    </div>

    <div class="faq" data-reveal data-faq>
      {faq.items.map((item, i) => (
        <div
          class:list={['faq-i', i === 0 && 'is-open', i === faq.items.length - 1 && 'faq-i--last']}
        >
          <h3 class="faq-i__h">
            <button
              class="faq-q"
              type="button"
              id={`faq-q-${i}`}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`faq-a-${i}`}
            >
              <span>{item.q}</span>
              <span class="faq-ic" aria-hidden="true">
                <span class="faq-ic__h"></span>
                <span class="faq-ic__v faq-v"></span>
              </span>
            </button>
          </h3>
          <div class="faq-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
            <div><p class="faq-a__p">{item.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-sec { background: var(--c-svet); padding: clamp(48px, 6vw, 80px) clamp(20px, 4vw, 24px) clamp(72px, 9vw, 120px); }
  .faq-sec__grid {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(36px, 5vw, 80px); align-items: start;
  }
  .faq-sec__head { display: flex; flex-direction: column; gap: clamp(18px, 2vw, 24px); }
  .faq-sec__title {
    margin: 0;
    font: 300 clamp(30px, 3.6vw, 54px)/1.15 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong); max-width: 18ch;
  }
  .faq { display: flex; flex-direction: column; }
  .faq-i { border-top: 1px solid var(--border-hairline); }
  .faq-i--last { border-bottom: 1px solid var(--border-hairline); }
  .faq-i__h { margin: 0; font: inherit; }
  .faq-q {
    width: 100%;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 26px 0; background: none; border: 0; cursor: pointer; text-align: left;
    font: 400 clamp(19px, 1.7vw, 23px)/1.4 var(--font-display); color: var(--text-strong);
  }
  .faq-ic { position: relative; width: 14px; height: 14px; flex: 0 0 auto; }
  .faq-ic__h { position: absolute; top: 6px; left: 0; width: 14px; height: 1px; background: var(--text-accent); display: block; }
  .faq-ic__v { position: absolute; left: 6px; top: 0; width: 1px; height: 14px; background: var(--text-accent); display: block; }
  .faq-a__p { font: var(--t-body); color: var(--text-muted); max-width: 56ch; padding-bottom: 26px; text-wrap: pretty; }
</style>
